{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git 协作台",
  "version": "0.2.0",
  "identifier": "com.gitcollab.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm@8.14.0 dev",
    "beforeBuildCommand": "corepack pnpm@8.14.0 build",
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Git 协作台",
      "width": 1040,
      "height": 720,
      "minWidth": 760,
      "minHeight": 560
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Git 协作台"
  }
}
